{
	"nodes":[
		{"id":"46e7d753d5dd446c","type":"group","x":300,"y":-710,"width":520,"height":480,"color":"6","label":"Religious & Ethical Frameworks"},
		{"id":"698e894721cb4999","type":"group","x":360,"y":-100,"width":520,"height":420,"color":"5","label":"Cultivating Kokoro (practice)"},
		{"id":"8008994610144eca","type":"group","x":360,"y":550,"width":520,"height":340,"color":"2","label":"Relational Implications"},
		{"id":"abc928207f8848c8","type":"group","x":-960,"y":-230,"width":480,"height":340,"color":"4","label":"Semantic Range"},
		{"id":"e43fbc8a22114caa","type":"group","x":-960,"y":-710,"width":480,"height":300,"color":"4","label":"Constituent Unity"},
		{"id":"516c28fb7ede4939","type":"group","x":-1000,"y":420,"width":480,"height":300,"color":"3","label":"Cultural Aesthetics"},
		{"id":"452d43c357bc4b2d","type":"group","x":-150,"y":760,"width":480,"height":260,"color":"1","label":"Further Reading & Vault Links"},
		{"id":"be8a1aaba99c4f0c","type":"text","text":"# 心 Kokoro\nUnity of heart, mind, body & spirit — not separate territories but one interwoven consciousness.","x":-150,"y":-60,"width":300,"height":120,"color":"4"},
		{"id":"9f552612306f4618","type":"text","text":"EN equivalents: heart, feeling, mind, soul, will, mood, sentiment…","x":-870,"y":220,"width":420,"height":60},
		{"id":"884f643befba4189","type":"text","text":"Nanzan Institute for Religion and Culture Journals","x":-120,"y":800,"width":420,"height":60},
		{"id":"ed2dfcea141c42c9","type":"text","text":"Maki Sato — Kokoro in the Apparatus of Physical/Psychological & Distributed/Central","x":-120,"y":870,"width":420,"height":70},
		{"id":"650ae47be81941b5","type":"text","text":"Teresa Nakaya — KOKORO's axiological aspects in moral education","x":-120,"y":950,"width":420,"height":60},
		{"id":"586043a7616d402c","type":"text","text":"Kōjien: \"source of a person's mental processes\" — knowledge, feeling, will","x":-930,"y":-190,"width":420,"height":80},
		{"id":"58b509a19ba94987","type":"text","text":"Nihon Kokugo Daijiten: organ of rational & emotional process, opposed to karada (体, body) & mono (物, thing)","x":-930,"y":-100,"width":420,"height":90},
		{"id":"b2021c87cf314172","type":"text","text":"Synonyms: seishin (精神, soul/psyche), tamashii (魂, spirit/willpower)","x":-930,"y":0,"width":420,"height":60},
		{"id":"6a63ff4ce49142eb","type":"text","text":"Buddhism — impermanence & compassion; Zen: discipline, mindfulness, direct experience → martial arts, tea ceremony, aesthetics","x":330,"y":-670,"width":460,"height":90},
		{"id":"c2b39320d40c47e0","type":"text","text":"Shinto — reverence for kami 神 in nature, ancestors, sacred places; purity (清潔, seiketsu)","x":330,"y":-570,"width":460,"height":80},
		{"id":"e70e8e4fb6a9471c","type":"text","text":"Bushidō — honor, courage, self-discipline, loyalty","x":330,"y":-480,"width":460,"height":70},
		{"id":"4168b18ec4274286","type":"text","text":"Shared core: purity, harmony with nature, communal ritual, belonging to land & mythic origin","x":330,"y":-400,"width":460,"height":70},
		{"id":"4c47a6fd72264229","type":"text","text":"Heart · Mind · Spirit · Body\nindivisible, not linked by \"and\" — no true division","x":-930,"y":-670,"width":420,"height":70},
		{"id":"f7ebcadab1994f73","type":"text","text":"Feel with kokoro (感じる) / Think with head (頭・考える)\n— Nakano Shigeru: kokoro leans emotional, not purely rational","x":-930,"y":-580,"width":420,"height":70},
		{"id":"627972ae1d9e435a","type":"text","text":"Kokoro ≠ shinzō (心臓, physical heart organ)","x":-930,"y":-490,"width":420,"height":60},
		{"id":"5d5c3752799e4236","type":"text","text":"Empathy — uniting in kokoro may mean carrying the burden of others","x":390,"y":590,"width":460,"height":70},
		{"id":"eb1af64d3d81469b","type":"text","text":"Avoiding conflict as love — less friction, natural flow of emotion, honour & responsibility over misery","x":390,"y":670,"width":460,"height":80},
		{"id":"7615e9f1b5144185","type":"text","text":"Compassion → purified heart & intention → deeper consciousness: spiritual/emotional, energy/body, symbolism/rational, physicality/cosmos","x":390,"y":760,"width":460,"height":90},
		{"id":"3300826127924c09","type":"text","text":"Sincerity & presence — intention with upmost sincerity, open heart, rooted in the moment","x":390,"y":-60,"width":460,"height":70},
		{"id":"c03734911cb14929","type":"text","text":"Radical honesty — welcome every insight, thought, emotion with care, kindness, compassion","x":390,"y":20,"width":460,"height":80},
		{"id":"d0c9b677c4484767","type":"text","text":"Inner sanctuary metaphor — the sacred garden; watering seeds; unseen winter growth before spring","x":390,"y":110,"width":460,"height":90},
		{"id":"2d0139dd1fc342b5","type":"text","text":"Cherry blossom koan — impermanence & fragility; fear of death vs. fear of living; honest reckoning with memory & emotion","x":390,"y":210,"width":460,"height":90},
		{"id":"f057b359c45e4a73","type":"text","text":"Wa 和 — harmony, consensus, avoidance of conflict, collective well-being","x":-970,"y":460,"width":420,"height":70},
		{"id":"27ddd851266e4537","type":"text","text":"Wabi-sabi 侘び寂び — beauty in transience & imperfection","x":-970,"y":540,"width":420,"height":70},
		{"id":"28cdf14cae244f1c","type":"text","text":"Mono no aware もののあわれ — the pathos of fleeting things","x":-970,"y":620,"width":420,"height":70}
	],
